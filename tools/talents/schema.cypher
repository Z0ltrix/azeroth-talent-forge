CREATE NODE TABLE Snapshot(id STRING PRIMARY KEY, game_build STRING, locale STRING, product STRING, channel STRING);
CREATE NODE TABLE Class(id INT64 PRIMARY KEY, slug STRING, name STRING);
CREATE NODE TABLE Spec(id INT64 PRIMARY KEY, class_id INT64, role STRING, name STRING);
CREATE NODE TABLE Tree(id INT64 PRIMARY KEY, kind STRING, class_id INT64, spec_id INT64);
CREATE NODE TABLE Subtree(id INT64 PRIMARY KEY, name STRING, tree_id INT64, currency_id INT64, required_level INT64);
CREATE NODE TABLE TraitNode(id INT64 PRIMARY KEY, tree_id INT64, subtree_id INT64, type INT64, x INT64, y INT64, codec_ordinal INT64);
CREATE NODE TABLE Entry(id INT64 PRIMARY KEY, node_id INT64, definition_id INT64, ordinal INT64, max_ranks INT64);
CREATE NODE TABLE Definition(id INT64 PRIMARY KEY, spell_id INT64, name STRING, description STRING, effect STRING, source STRING);
CREATE NODE TABLE SpellEffect(id INT64 PRIMARY KEY, definition_id INT64, effect_index INT64, operation_type INT64, curve_id INT64);
CREATE NODE TABLE Currency(id INT64 PRIMARY KEY, kind STRING);
CREATE NODE TABLE CurrencySource(id INT64 PRIMARY KEY, currency_id INT64, amount INT64, level INT64, ordinal INT64);
CREATE NODE TABLE Condition(id INT64 PRIMARY KEY, source_condition_id INT64, source STRING, tree_id INT64, node_id INT64, entry_id INT64, currency_id INT64, spent INT64, level INT64, granted_ranks INT64, type INT64);
CREATE NODE TABLE Gate(id INT64 PRIMARY KEY, anchor_node_id INT64, currency_id INT64, required_spend INT64);
CREATE NODE TABLE Preset(id STRING PRIMARY KEY, label STRING, category STRING, code STRING, spec_id INT64, hero_subtree_id INT64, source_url STRING, source_name STRING, claimed_patch STRING);
CREATE REL TABLE HAS_SPEC(FROM Class TO Spec);
CREATE REL TABLE USES_CLASS_TREE(FROM Class TO Tree);
CREATE REL TABLE USES_SPEC_TREE(FROM Spec TO Tree);
CREATE REL TABLE ALLOWS_HERO_TREE(FROM Spec TO Tree);
CREATE REL TABLE HAS_NODE(FROM Tree TO TraitNode);
CREATE REL TABLE HAS_SUBTREE(FROM Tree TO Subtree);
CREATE REL TABLE HAS_ENTRY(FROM TraitNode TO Entry);
CREATE REL TABLE USES_DEFINITION(FROM Entry TO Definition);
CREATE REL TABLE HAS_EFFECT(FROM Definition TO SpellEffect);
CREATE REL TABLE HAS_CONDITION(FROM TraitNode TO Condition);
CREATE REL TABLE ENTRY_HAS_CONDITION(FROM Entry TO Condition);
CREATE REL TABLE TREE_HAS_CONDITION(FROM Tree TO Condition);
CREATE REL TABLE REQUIRED_FOR(FROM TraitNode TO TraitNode);
CREATE REL TABLE SUFFICIENT_FOR(FROM TraitNode TO TraitNode);
CREATE REL TABLE MUTUALLY_EXCLUSIVE(FROM TraitNode TO TraitNode);
CREATE REL TABLE VISUAL_EDGE(FROM TraitNode TO TraitNode);
CREATE REL TABLE COSTS(FROM TraitNode TO Currency, amount INT64);
CREATE REL TABLE UNLOCKS(FROM Currency TO CurrencySource);
CREATE REL TABLE GRANTS(FROM Spec TO TraitNode, entry_id INT64, ranks INT64);
CREATE REL TABLE SERIALIZES(FROM Spec TO TraitNode, ordinal INT64);
CREATE REL TABLE FOR_SPEC(FROM Preset TO Spec);
